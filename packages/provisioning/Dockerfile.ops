# SPDX-License-Identifier: MPL-2.0
#
# Caelo CMS — `caelo-ops` image (epic #696, Phase 2).
#
# The provisioning CLI (`cms-provision`, exposed as `caelo-ops`) plus
# every external tool it shells out to, at pinned versions:
#   - Bun          — runs the CLI (base image tag).
#   - Node         — Pulumi's nodejs language host runs the stack
#                    programs under node + ts-node, not under Bun.
#   - Pulumi CLI   — converges the stacks in packages/provisioning/stacks.
#   - gcloud (+ beta — the Debian package ships the beta command group;
#                    `gcloud components install` is disabled for
#                    package-manager installs, so nothing is fetched at
#                    run time; the CI boot smoke runs `gcloud beta`).
#   - cosign       — verifies the signed release manifest + image digests.
#
# Several run modes share this one image (see #696, #819): the operator's
# own terminal (first install, break-glass upgrades), the install job and
# the converge job (both as the install's caelo-provisioner; the converge
# job installs releases that change the cloud setup), and the upgrader job
# (a dedicated identity without IAM write). The image itself is
# mode-agnostic: it is "the CLI, reproducibly".
#
# Every downloaded binary is pinned by version AND sha256, verified at
# build time; a mismatch fails the build. Bumping a tool = bump the
# version ARG + both per-arch checksums in the same commit (the
# checksums come from the vendor's published checksum file / apt
# `Packages` index — cite which in the PR).
#
# Multi-arch (linux/amd64 + linux/arm64). The workspace install + tsc
# build run in a builder pinned to $BUILDPLATFORM, so Bun never executes
# under QEMU (oven-sh/bun#15044 SIGILLs there — the reason admin/gateway
# stay amd64-only). The provisioning closure is pure JS (no `.node`
# bindings), so the node_modules built on amd64 are valid on arm64.
#
# CLAUDE.md §11.C: published to ghcr.io/caelo-cms/ops by
# .github/workflows/release-images.yml, cosign-signed, mirrored to the
# GCP public Artifact Registry. Operators never build it.

ARG BUN_VERSION=1.4.2

FROM node:26.11.1-bookworm-slim AS node

# ---------------------------------------------------------------------------
# Builder — always the build host's architecture (no Bun under QEMU).
# ---------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM oven/bun:${BUN_VERSION} AS builder

WORKDIR /repo

# bunfig.toml pins `linker = "hoisted"` (see apps/admin/Dockerfile for the
# load-bearing reason) — it must be in place before `bun install`. The full
# tree follows because `--frozen-lockfile` needs every workspace manifest
# to match bun.lock, and copying them one by one would break the moment a
# workspace is added.
COPY package.json bun.lock bunfig.toml tsconfig.base.json tsconfig.json ./
COPY . .

# Build: the provisioning closure + the root workspace (tsc and the bun
# type definitions are root devDependencies). `tsc -b` on provisioning
# builds @caelo-cms/shared through its project reference.
RUN bun install --frozen-lockfile --filter @caelo-cms/provisioning --filter @caelo-cms/platform-updater --filter caelo-cms && \
    bun run --filter @caelo-cms/provisioning build

# Runtime closure: drop devDependencies and the root workspace's tooling.
RUN rm -rf node_modules packages/*/node_modules && \
    bun install --frozen-lockfile --production --filter @caelo-cms/provisioning --filter @caelo-cms/platform-updater && \
    if find node_modules -name '*.node' -print -quit | grep -q .; then \
      echo "native addon in the provisioning closure — the cross-arch copy below is no longer valid" >&2; \
      exit 1; \
    fi

# Assemble the install tree in the same shape as the published npm
# package's workspace: stacks import `../../dist/*.js`, and the CLI
# resolves stacks relative to its own dist/. @caelo-cms/shared needs its
# src/ too: its `bun` export condition points at src/index.ts, and Bun
# picks that condition over dist/.
#
# The upgrader job (`caelo-ops upgrader`, epic #696) is the private
# @caelo-cms/platform-updater package: provisioning's runUpgraderJob wired
# to the database through @caelo-cms/query-api. Both run from src/ (they
# are not published, so they have no dist/), as does provisioning's `bun`
# export condition the updater imports through.
RUN mkdir -p /opt/caelo-ops/packages/shared /opt/caelo-ops/packages/provisioning \
             /opt/caelo-ops/packages/query-api /opt/caelo-ops/packages/platform-updater && \
    cp package.json /opt/caelo-ops/ && \
    cp -a node_modules /opt/caelo-ops/ && \
    cp -a packages/shared/package.json packages/shared/dist packages/shared/src /opt/caelo-ops/packages/shared/ && \
    cp -a packages/provisioning/package.json packages/provisioning/dist packages/provisioning/src \
          packages/provisioning/stacks packages/provisioning/caddy \
          packages/provisioning/static /opt/caelo-ops/packages/provisioning/ && \
    cp -a packages/query-api/package.json packages/query-api/src /opt/caelo-ops/packages/query-api/ && \
    cp -a packages/platform-updater/package.json packages/platform-updater/src /opt/caelo-ops/packages/platform-updater/ && \
    find /opt/caelo-ops/packages -name '*.test.ts' -delete

# ---------------------------------------------------------------------------
# Runtime — one per target architecture.
# ---------------------------------------------------------------------------
FROM oven/bun:${BUN_VERSION}-slim AS runtime

ARG TARGETARCH

# Pulumi CLI — https://github.com/pulumi/pulumi/releases (checksums from
# pulumi-<version>-checksums.txt).
ARG PULUMI_VERSION=3.268.0
ARG PULUMI_SHA256_AMD64=903cafeaa9f6327e4bf53a8b7b99ae660f26198acfa804a2f982bf5de3f1de0b
ARG PULUMI_SHA256_ARM64=47c1b9283b7997337b0a373d240f771a6aeb42ee5dd2e213c14604247c7ff15a

# cosign — https://github.com/sigstore/cosign/releases (checksums from
# cosign_checksums.txt).
ARG COSIGN_VERSION=3.1.3
ARG COSIGN_SHA256_AMD64=4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71
ARG COSIGN_SHA256_ARM64=c5d324e091826b0d7a78eb16fef316450b4eb9aaec045611c08ba06f5e73220a

# google-cloud-cli — the .deb from Google's apt pool, fetched by its exact
# pool path and checked against the SHA256 in the repo's `Packages` index
# (https://packages.cloud.google.com/apt/dists/cloud-sdk/main/binary-<arch>/Packages).
ARG GCLOUD_VERSION=589.0.0
ARG GCLOUD_DEB_AMD64=google-cloud-cli_589.0.0-0_amd64_11a5e26c14eb3046bf3c48a38d039f69.deb
ARG GCLOUD_SHA256_AMD64=fed8d4fb16cb225989c55fdd3b7244bb71e5e05231250abc540724aa0f108f92
ARG GCLOUD_DEB_ARM64=google-cloud-cli_589.0.0-0_arm64_5f0d2dae7b76e41abb6cc9a73ac918d7.deb
ARG GCLOUD_SHA256_ARM64=c159f1ac99700bf147c11293bb97ac548a06a3dc82d71fab9d042d7b79d855b6

# Node from the official image (same pin as apps/admin/Dockerfile). Since
# Node 26 the binary links libatomic.so.1, installed below.
COPY --from=node /usr/local/bin/node /usr/local/bin/node

# python3: gcloud's runtime (the .deb declares python3 >= 3.10).
# ca-certificates + curl: the verified downloads below; curl is removed
# again afterwards.
RUN set -eu && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl python3 libatomic1 && \
    case "${TARGETARCH}" in \
      amd64) PULUMI_ARCH=x64;   PULUMI_SHA="${PULUMI_SHA256_AMD64}"; COSIGN_SHA="${COSIGN_SHA256_AMD64}"; GCLOUD_DEB="${GCLOUD_DEB_AMD64}"; GCLOUD_SHA="${GCLOUD_SHA256_AMD64}" ;; \
      arm64) PULUMI_ARCH=arm64; PULUMI_SHA="${PULUMI_SHA256_ARM64}"; COSIGN_SHA="${COSIGN_SHA256_ARM64}"; GCLOUD_DEB="${GCLOUD_DEB_ARM64}"; GCLOUD_SHA="${GCLOUD_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    tmp="$(mktemp -d)" && cd "${tmp}" && \
    curl -fsSLo pulumi.tgz "https://github.com/pulumi/pulumi/releases/download/v${PULUMI_VERSION}/pulumi-v${PULUMI_VERSION}-linux-${PULUMI_ARCH}.tar.gz" && \
    echo "${PULUMI_SHA}  pulumi.tgz" | sha256sum -c - && \
    tar -xzf pulumi.tgz && install -m 0755 pulumi/* /usr/local/bin/ && \
    curl -fsSLo cosign "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-${TARGETARCH}" && \
    echo "${COSIGN_SHA}  cosign" | sha256sum -c - && \
    install -m 0755 cosign /usr/local/bin/cosign && \
    curl -fsSLo gcloud.deb "https://packages.cloud.google.com/apt/pool/cloud-sdk/${GCLOUD_DEB}" && \
    echo "${GCLOUD_SHA}  gcloud.deb" | sha256sum -c - && \
    dpkg -i gcloud.deb && \
    cd / && rm -rf "${tmp}" && \
    apt-get purge -y curl && apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/* && \
    node --version && pulumi version && cosign version >/dev/null && \
    gcloud version 2>/dev/null | grep -qx "Google Cloud SDK ${GCLOUD_VERSION}"

COPY --from=builder /opt/caelo-ops /opt/caelo-ops

# A wrapper, not a symlink: the CLI derives its repo root and stack paths
# from its own file location (import.meta.dir), which a symlink in
# /usr/local/bin would point at the wrong directory.
#
# `caelo-ops upgrader` runs the upgrader job and passes it NOTHING: it
# reads its input from the database only (platform-updater/src/main.ts),
# so extra arguments are dropped here, not interpreted.
#
# The converge job (#819) runs as caelo-provisioner, so its entry point is
# stricter (#883 review): the job is deployed with
# `--command=caelo-converge-job --args=converge-job`, and that script
# refuses any other argument and starts the job with a scrubbed
# environment (packages/provisioning/ops/caelo-converge-job). `caelo-ops
# converge-job` goes through the same script.
COPY --chmod=0755 packages/provisioning/ops/caelo-converge-job /usr/local/bin/caelo-converge-job
RUN printf '#!/bin/sh\nif [ "${1:-}" = upgrader ]; then exec bun /opt/caelo-ops/packages/platform-updater/src/main.ts; fi\nif [ "${1:-}" = converge-job ]; then exec caelo-converge-job "$@"; fi\nexec bun /opt/caelo-ops/packages/provisioning/dist/cli.js "$@"\n' \
      > /usr/local/bin/caelo-ops && \
    chmod 0755 /usr/local/bin/caelo-ops && \
    ln -s caelo-ops /usr/local/bin/cms-provision && \
    useradd --system --uid 10001 --create-home --home-dir /home/caelo --shell /usr/sbin/nologin caelo && \
    chown -R caelo:caelo /opt/caelo-ops/packages/provisioning/stacks

# Non-root. State the CLI writes (~/.caelo-<id>/, ~/.pulumi/, gcloud
# config) lands under the caelo user's home. The stacks directory is the
# one place under /opt it writes: Pulumi keeps `Pulumi.<stack>.yaml` next
# to `Pulumi.yaml`, so the chown above hands just that tree to caelo.
USER caelo
WORKDIR /home/caelo
ENV HOME=/home/caelo \
    PULUMI_SKIP_UPDATE_CHECK=true \
    CLOUDSDK_CORE_DISABLE_PROMPTS=1 \
    CLOUDSDK_COMPONENT_MANAGER_DISABLE_UPDATE_CHECK=true

LABEL org.opencontainers.image.title="Caelo CMS — ops"

ENTRYPOINT ["caelo-ops"]
CMD ["--help"]
