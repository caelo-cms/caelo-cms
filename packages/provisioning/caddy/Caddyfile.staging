# SPDX-License-Identifier: MPL-2.0
#
# Staging vhost. Per CMS_REQUIREMENTS §16.5 staging is always noindexed at
# the serving layer (not just via robots.txt body) — `X-Robots-Tag:
# noindex, nofollow` is enforced here so a misconfigured robots.txt can
# never accidentally let a bot index a staging page.
#
# `try_files` falls back to <slug>/index.html so the page-output paths
# the static generator emits ("about/index.html") work as clean URLs.
#
# P6.2 — root is /srv/current, a symlink the deploy.trigger op atomically
# re-targets to the most recent build. Caddy follows the symlink at
# request time so a deploy is invisible to in-flight requests.

:80 {
	root * /srv/current
	# Content-hashed build outputs (fonts, plugin bundles) never change
	# under the same URL — cache them for a year. Keep this pattern in
	# sync with CONTENT_HASHED_PATH_PATTERN in @caelo-cms/shared
	# (enforced by packages/provisioning/src/index.test.ts). Pages and
	# slug-addressed media keep file_server's ETag/Last-Modified default.
	# `file` gates the header on the file existing: a 404 for a hashed
	# URL (old page after a deploy switch) must not be cached for a year.
	@content_hashed {
		path_regexp content_hashed ^/(?:_app/immutable/.+|_assets/fonts/[^/]+/[0-9a-f]{16,64}\.(?:woff2|woff|ttf|otf)|_caelo/plugin/[^/]+/[^/]+\.[0-9a-f]{12}\.(?:js|css))$
		file
	}
	header @content_hashed Cache-Control "public, max-age=31536000, immutable"
	encode gzip
	header X-Robots-Tag "noindex, nofollow"
	try_files {path} {path}/index.html
	file_server
}
