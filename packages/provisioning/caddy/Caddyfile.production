# SPDX-License-Identifier: MPL-2.0
#
# Production vhost. No noindex header — the bot-indexing behavior comes
# straight from each page's emitted robots.txt (CMS_REQUIREMENTS §8.3).
#
# P6.2 — root is /srv/current, a symlink the deploy.trigger /
# deploy.promote / deploy.rollback ops atomically re-target. The
# routing manifest (/srv/current/routing-manifest.json) lists every
# emitted page + its output path; P9 will swap this Caddyfile for one
# that consults the manifest to handle locale URL strategies, and P13
# will use the same indirection for A/B variant edge selection.

:80 {
	root * /srv/current
	# Content-hashed build outputs (fonts, plugin bundles) never change
	# under the same URL — cache them for a year. Keep this pattern in
	# sync with CONTENT_HASHED_PATH_PATTERN in @caelo-cms/shared
	# (enforced by packages/provisioning/src/index.test.ts). Pages and
	# slug-addressed media keep file_server's ETag/Last-Modified default.
	@content_hashed path_regexp content_hashed ^/(?:_app/immutable/.+|_assets/fonts/[^/]+/[0-9a-f]{16,64}\.(?:woff2|woff|ttf|otf)|_caelo/plugin/[^/]+/[^/]+\.[0-9a-f]{12}\.(?:js|css))$
	header @content_hashed Cache-Control "public, max-age=31536000, immutable"
	encode gzip
	try_files {path} {path}/index.html
	file_server
}
