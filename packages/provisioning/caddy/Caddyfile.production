# SPDX-License-Identifier: MPL-2.0
#
# Production vhost. No noindex header — the bot-indexing behavior comes
# straight from each page's emitted robots.txt (CMS_REQUIREMENTS §8.3).
#
# P6.2 — root is /srv/current, a symlink the deploy.trigger /
# deploy.promote / deploy.rollback ops atomically re-target. The
# routing manifest (/srv/current/routing-manifest.json) lists every
# emitted page + its output path.

:80 {
	root * /srv/current
	# #587 — the redirects table of the build served here (the generator
	# writes it; `*` so a fresh checkout without a build still starts).
	# docker-compose.yml reloads Caddy when it changes (caddy-redirects.ts).
	import /srv/current/_redirects.caddy*
	# Content-hashed build outputs (fonts, plugin bundles, media) never
	# change under the same URL — cache them for a year. Keep this pattern in
	# sync with CONTENT_HASHED_PATH_PATTERN in @caelo-cms/shared
	# (enforced by packages/provisioning/src/index.test.ts). Pages and
	# manifests keep file_server's ETag/Last-Modified default.
	# `file` gates the header on the file existing: a 404 for a hashed
	# URL (old page after a deploy switch) must not be cached for a year.
	@content_hashed {
		path_regexp content_hashed ^/(?:_app/immutable/.+|_assets/fonts/[^/]+/[0-9a-f]{16}\.woff2|_assets/fonts/pinned/[0-9a-f]{64}\.[0-9a-f]{12}\.[a-z]+(?:-[a-z]+)?\.[0-9a-f]{12}\.woff2|_assets/[a-z0-9][a-z0-9-]*(?:/[a-z][a-z0-9-]*)?\.[0-9a-f]{16}\.[a-z0-9]{2,5}|_caelo/plugin/[^/]+/[^/]+\.[0-9a-f]{12}\.(?:js|css))$
		file
	}
	header @content_hashed Cache-Control "public, max-age=31536000, immutable"
	# Favicons ship as the one icon MIME the media library stores and the
	# page's <link rel="icon" type> declares, not the host mime.types name.
	@ico path *.ico
	header @ico Content-Type "image/x-icon"
	encode gzip
	try_files {path} {path}/index.html
	file_server
}
