exports[`shipped plugins' public surface (#1332) consent-manager: matches the reviewed surface 1`] = `
{
  "mailTemplates": {},
  "mailUnsubscribe": null,
  "publicOperations": [
    {
      "captcha": "none",
      "inputJsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "consentId": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "granted": {
            "items": {
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string",
            },
            "maxItems": 32,
            "type": "array",
          },
          "policyVersion": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer",
          },
        },
        "required": [
          "consentId",
          "granted",
          "policyVersion",
        ],
        "type": "object",
      },
      "kind": "write",
      "name": "record_consent",
      "rateLimit": {
        "max": 20,
        "windowSeconds": 60,
      },
      "reads": [],
      "run": {
        "action": "insert",
        "answer": {
          "recorded": true,
        },
        "checks": [
          {
            "check": "equals-row",
            "column": "policy_version",
            "field": "policyVersion",
            "refusal": "record_consent: the policy version is not the current one; the visitor must be asked again",
            "source": {
              "of": "adminSchema",
              "table": "settings",
            },
          },
          {
            "check": "all-in",
            "column": "key",
            "field": "granted",
            "refusal": "record_consent: unknown consent categories",
            "source": {
              "of": "adminSchema",
              "table": "categories",
            },
          },
        ],
        "table": "consent_log",
        "values": {
          "consent_id": {
            "field": "consentId",
            "from": "input",
          },
          "granted": {
            "distinct": true,
            "field": "granted",
            "from": "input",
          },
          "policy_version": {
            "field": "policyVersion",
            "from": "input",
          },
        },
      },
      "writes": [
        "consent_log",
      ],
    },
  ],
  "requires": [],
  "tables": {
    "consent_log": {
      "kind": "inbox",
      "visitorPrivileges": [
        "INSERT",
      ],
    },
  },
}
`;

exports[`shipped plugins' public surface (#1332) forms: matches the reviewed surface 1`] = `
{
  "mailTemplates": {},
  "mailUnsubscribe": null,
  "publicOperations": [
    {
      "captcha": "required",
      "inputJsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "captchaToken": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
          },
          "data": {
            "additionalProperties": {
              "anyOf": [
                {
                  "maxLength": 10000,
                  "type": "string",
                },
                {
                  "type": "number",
                },
                {
                  "type": "boolean",
                },
                {
                  "type": "null",
                },
              ],
            },
            "propertyNames": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "type": "object",
          },
          "formSlug": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string",
          },
          "honeypot": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
          },
          "pageId": {
            "maxLength": 200,
            "type": "string",
          },
        },
        "required": [
          "formSlug",
          "data",
        ],
        "type": "object",
      },
      "kind": "write",
      "name": "submit",
      "rateLimit": {
        "max": 10,
        "windowSeconds": 60,
      },
      "reads": [
        "forms",
      ],
      "run": {
        "action": "insert",
        "answer": {
          "submissionId": {
            "from": "inserted-id",
          },
        },
        "checks": [
          {
            "check": "form-fields",
            "definitionColumn": "schema_json",
            "field": "data",
            "keyColumn": "slug",
            "keyField": "formSlug",
            "missing": "submit: this form does not exist",
            "source": {
              "of": "schema",
              "table": "forms",
            },
          },
        ],
        "honeypot": {
          "answer": {
            "honeypot": true,
            "submissionId": {
              "from": "inserted-id",
            },
          },
          "field": "honeypot",
          "store": "marked",
          "values": {
            "status": {
              "from": "const",
              "value": "spam",
            },
          },
        },
        "table": "form_submissions",
        "values": {
          "data": {
            "field": "data",
            "from": "input",
          },
          "form_slug": {
            "field": "formSlug",
            "from": "input",
          },
          "page_id": {
            "field": "pageId",
            "from": "input",
            "orElse": "",
          },
          "status": {
            "from": "const",
            "value": "new",
          },
        },
      },
      "writes": [
        "form_submissions",
      ],
    },
  ],
  "requires": [],
  "tables": {
    "form_submissions": {
      "kind": "inbox",
      "visitorPrivileges": [
        "INSERT",
      ],
    },
    "forms": {
      "kind": "published",
      "visitorPrivileges": [
        "SELECT",
      ],
    },
  },
}
`;

