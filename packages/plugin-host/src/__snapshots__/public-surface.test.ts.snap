{
  "mailTemplates": {},
  "mailUnsubscribe": null,
  "publicOperations": [
    {
      "captcha": "required",
      "inputJsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "authorName": {
            "maxLength": 80,
            "type": "string",
          },
          "content": {
            "maxLength": 4000,
            "type": "string",
          },
          "hp_address": {
            "maxLength": 500,
            "type": "string",
          },
          "pageId": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
        },
        "required": [
          "pageId",
          "authorName",
          "content",
        ],
        "type": "object",
      },
      "kind": "write",
      "name": "submit",
      "rateLimit": {
        "max": 10,
        "windowSeconds": 60,
      },
      "reads": [],
      "run": {
        "action": "insert",
        "answer": {
          "commentId": {
            "from": "inserted-id",
          },
          "status": "pending",
        },
        "checks": [
          {
            "check": "not-blank",
            "field": "content",
            "refusal": "submit: content empty",
          },
          {
            "check": "not-blank",
            "field": "authorName",
            "refusal": "submit: authorName required",
          },
        ],
        "honeypot": {
          "answer": {
            "commentId": "00000000-0000-0000-0000-000000000000",
            "status": "pending",
          },
          "field": "hp_address",
          "store": "nothing",
        },
        "table": "comments",
        "values": {
          "author_name": {
            "field": "authorName",
            "from": "input",
            "trim": true,
          },
          "content": {
            "field": "content",
            "from": "input",
            "trim": true,
          },
          "page_id": {
            "field": "pageId",
            "from": "input",
          },
          "status": {
            "from": "const",
            "value": "pending",
          },
        },
      },
      "writes": [
        "comments",
      ],
    },
    {
      "captcha": "none",
      "inputJsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "before": {
            "additionalProperties": false,
            "properties": {
              "archivedAt": {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{6}(?:Z))$",
                "type": "string",
              },
              "id": {
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string",
              },
            },
            "required": [
