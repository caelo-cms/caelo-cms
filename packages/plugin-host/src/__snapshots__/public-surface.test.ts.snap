exports[`shipped plugins' public surface (#1332) consent-manager: matches the reviewed surface 1`] = `
{
  "publicOperations": [
    {
      "captcha": "none",
      "inputJsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "consentId": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "granted": {
            "items": {
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string",
            },
            "maxItems": 32,
            "type": "array",
          },
          "policyVersion": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer",
          },
        },
        "required": [
          "consentId",
          "granted",
          "policyVersion",
        ],
        "type": "object",
      },
      "kind": "write",
      "name": "record_consent",
      "rateLimit": {
        "max": 20,
        "windowSeconds": 60,
      },
      "reads": [],
      "writes": [
        "consent_log",
      ],
    },
  ],
  "requires": [],
  "tables": {
    "consent_log": {
      "kind": "inbox",
      "visitorPrivileges": [
        "INSERT",
      ],
    },
  },
}
`;

