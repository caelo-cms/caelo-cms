{
  "name": "@caelo-cms/mcp-server",
  "version": "0.10.23",
  "private": false,
  "license": "MPL-2.0",
  "description": "MCP servers for Caelo CMS: `caelo_chat` (talk to Caelo's own AI) and the admin-scoped Power-MCP (the full chat-runner tool catalogue, driven by your own agent). Lets Claude Code (or any MCP-aware client) drive a Caelo install from outside the browser.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caelo-cms/caelo-cms.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/caelo-cms/caelo-cms#readme",
  "bugs": "https://github.com/caelo-cms/caelo-cms/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "caelo-mcp-server": "./dist/index.js",
    "caelo-admin-mcp": "./dist/admin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b --force",
    "prepublishOnly": "tsc -b --force"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
