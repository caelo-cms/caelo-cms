{
  "name": "@caelo-cms/migrations",
  "version": "0.12.18",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema/cms_admin": "./src/schema/cms_admin/index.ts",
    "./schema/cms_public": "./src/schema/cms_public/index.ts",
    "./public-projection": "./src/public-projection.ts",
    "./role-audit": "./src/role-audit.ts",
    "./template-install": "./src/template-install.ts"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "generate:admin": "drizzle-kit generate --config=drizzle.config.cms-admin.ts",
    "generate:public": "drizzle-kit generate --config=drizzle.config.cms-public.ts",
    "migrate:admin": "bun run src/migrate.ts admin",
    "migrate:public": "bun run src/migrate.ts public",
    "migrate:public-staging": "bun run src/migrate.ts public-staging",
    "migrate": "bun run migrate:admin && bun run migrate:public && bun run migrate:public-staging",
    "install-from-template": "bun run src/install-from-template.ts"
  },
  "dependencies": {
    "@caelo-cms/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
