# Copy to .env and adjust for your local dev environment.
# .env is gitignored — never commit real secrets.

# PostgreSQL superuser (docker-compose)
POSTGRES_USER=caelo
POSTGRES_PASSWORD=caelo_dev
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Application roles created by packages/migrations/src/bootstrap.sh on first boot.
ADMIN_ROLE_PASSWORD=caelo_admin_dev
PUBLIC_ROLE_PASSWORD=caelo_public_dev
# The API gateway's own cms_admin login (#613). A database created before
# this role existed: re-run bootstrap.sh (idempotent) with it set — it
# creates the role and re-applies migration 0248's grants.
GATEWAY_ROLE_PASSWORD=caelo_gateway_dev

# Application connection URLs.
# admin_role connects to cms_admin (authoring) and to cms_public (schema owner for DDL / migrations only).
# public_role connects to cms_public (plugin-data API gateway path).
# A URL may also leave the password out and take it from <NAME>_PASSWORD
# (ADMIN_DATABASE_URL → ADMIN_DATABASE_PASSWORD) — cloud installs do that so
# the password comes from the secret manager, not from the URL.
ADMIN_DATABASE_URL=postgres://admin_role:caelo_admin_dev@localhost:5432/cms_admin
PUBLIC_ADMIN_DATABASE_URL=postgres://admin_role:caelo_admin_dev@localhost:5432/cms_public
PUBLIC_DATABASE_URL=postgres://public_role:caelo_public_dev@localhost:5432/cms_public
# gateway_role connects to cms_admin with the narrow grants of migration 0248.
# The API gateway uses only this + PUBLIC_DATABASE_URL and refuses to start
# while an ADMIN_* / PUBLIC_ADMIN_* credential is in its environment.
GATEWAY_DATABASE_URL=postgres://gateway_role:caelo_gateway_dev@localhost:5432/cms_admin

# Project KEK — 32 bytes hex (64 hex chars). Encrypts AI provider API keys
# and other at-rest secrets in cms_admin. Auto-generated to .caelo/dev-kek
# on first `bun run dev` if unset; production installs MUST mount this from
# Secret Manager / equivalent. Generate with:
#   bun -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
# CAELO_SECRET_KEK=

# Public URL of the generated site. The admin writes it into the SEO settings
# (canonical, og:url, sitemap) on first boot when none is configured; real
# installs get https://<domain> from provisioning. Locally the production
# build is served on :8082.
CAELO_SITE_URL=http://localhost:8082

# Accommodate an 8 MiB font plus license/form overhead in the built admin.
BODY_SIZE_LIMIT=12M
