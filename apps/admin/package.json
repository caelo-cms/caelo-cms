{
  "name": "@caelo-cms/admin",
  "version": "0.10.29",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "sync": "svelte-kit sync",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig tsconfig.json && tsc --noEmit",
    "dev": "svelte-kit sync && bun --bun vite dev",
    "build": "svelte-kit sync && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "seed:dev": "bun --env-file=../../.env run scripts/seed-dev-owner.ts",
    "e2e": "playwright test",
    "e2e-livedit": "svelte-kit sync && bun run plugins:build && ORIGIN=http://localhost:4173 bun --bun vite build && playwright test --config playwright.livedit.config.ts",
    "e2e-livedit:headed": "svelte-kit sync && bun run plugins:build && ORIGIN=http://localhost:4173 bun --bun vite build && playwright test --config playwright.livedit.config.ts --headed",
    "e2e-livedit:debug": "svelte-kit sync && bun run plugins:build && ORIGIN=http://localhost:4173 bun --bun vite build && playwright test --config playwright.livedit.config.ts --headed --debug --workers=1",
    "plugins:build": "tsc -b --force ../../packages/plugins/*"
  },
  "dependencies": {
    "@caelo-cms/admin-core": "workspace:*",
    "@caelo-cms/font-service": "workspace:*",
    "@caelo-cms/plugin-host": "workspace:*",
    "@caelo-cms/plugin-sdk": "workspace:*",
    "@caelo-cms/query-api": "workspace:*",
    "@caelo-cms/redeploy-orchestrator": "workspace:*",
    "@caelo-cms/shared": "workspace:*",
    "@google-cloud/storage": "^8.2.0",
    "bits-ui": "^2.19.4",
    "clsx": "^2.1.1",
    "colorjs.io": "^0.7.1",
    "dompurify": "^3",
    "file-type": "^22",
    "html2canvas-pro": "2.5.0",
    "htmlparser2": "12.0.0",
    "lucide-svelte": "^1.0.1",
    "marked": "^18",
    "mode-watcher": "^1.1.0",
    "svelte-dnd-action": "^0.9.79",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "sharp": "^0.35",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "^4.3.3",
    "vite": "8.3.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4",
    "@rollup/rollup-darwin-x64": "^4",
    "@rollup/rollup-linux-arm64-gnu": "^4",
    "@rollup/rollup-linux-arm64-musl": "^4",
    "@rollup/rollup-linux-x64-gnu": "^4",
    "@rollup/rollup-linux-x64-musl": "^4"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
